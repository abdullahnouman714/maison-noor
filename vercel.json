{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite"
    },
    "maison-noor-api": {
      "root": "server",
      "framework": "express",
      "entrypoint": "src/index.js",
      "buildCommand": "npm install"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "maison-noor-api" } },
    { "source": "/(.*)", "destination": { "service": "client" } }
  ]
}
